# 统一换行符，避免 Windows/macOS 协作者的 CRLF 抖动
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.txt     text eol=lf
*.example text eol=lf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.xlsx    binary
*.index   binary
*.pkl     binary
*.safetensors binary
*.bin     binary
